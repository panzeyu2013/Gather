# Local-only native fixtures (ONNX models + RAW photos with faces).
tests/fixtures/local/

# 证书/签名材料（审计 P2-安全：防止密钥材料入库）。
*.p12
*.cer
*.crt
*.pem
*.key
*.mobileprovision
*.entitlements.xcconfig

# gh CLI 的临时缓存（CI 日志下载等），不得入库
.gh-tmp-cache/
