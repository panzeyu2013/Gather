<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- N08：声明应用支持的本地化。缺失时 macOS 只把 app 当成英文单语，
	     中文界面下系统菜单（关于/隐藏/服务/窗口/帮助）仍是英文。 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Gather</string>
	<key>CFBundleExecutable</key>
	<string>Gather</string>
	<key>CFBundleIdentifier</key>
	<string>com.gather.desktop.native</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Gather</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- WP6c 版本注入点：build.sh 组装时用 plutil -replace 写入这里的两项，
	     取值来自 GATHER_VERSION（优先）或 git describe 的最近 tag；
	     CFBundleVersion 另可用 GATHER_BUILD_NUMBER / git 提交数覆盖。
	     两者都取不到时保留下面的 3.0.0（本地开发回退，不作为发布版本）。 -->
	<key>CFBundleShortVersionString</key>
	<string>3.0.0</string>
	<key>CFBundleVersion</key>
	<string>3.0.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Gather 需要通过自动化（AppleScript）读取 Capture One 当前选中的照片并同步元数据，以实现从 Capture One 导入与写回。</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Gather import links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gather</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Gather Photos</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
				<string>com.adobe.raw-image</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
