{
  "name": "gather",
  "private": true,
  "version": "3.0.0",
  "license": "MIT",
  "description": "Capture One photo organization — similarity grouping and face keywording",
  "main": "dist/main/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "electron-rebuild",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.main.json",
    "electron": "NODE_ENV=production electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@gather/shared": "*",
    "@tanstack/react-query": "^5.0.0",
    "better-sqlite3": "^12.11.1",
    "exifr": "^7.1.0",
    "exiftool-vendored": "^37.0.0",
    "fast-xml-parser": "^4.0.0",
    "i18next": "^26.3.6",
    "onnxruntime-node": "^1.27.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "tsyringe": "^4.10.0",
    "zustand": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^4.0.0",
    "axe-core": "^4.13.0",
    "electron": "42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
